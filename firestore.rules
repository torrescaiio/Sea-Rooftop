rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Só entra quem foi cadastrado pela gerência (tem documento em user_roles).
    // Conta criada por fora, sem cadastro, não lê nem grava nada.
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid));
    }

    function isAdmin() {
      return isMember()
        && get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin';
    }

    // Perfis e cargos: a equipe pode ver, só admin cria, muda ou remove.
    // Ninguém consegue se promover a admin sozinho.
    match /user_roles/{userId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Demais dados do Command Center: só membros cadastrados.
    // (user_roles fica de fora daqui, senão esta regra liberaria a escrita nele.)
    match /{colecao}/{document=**} {
      allow read, write: if colecao != 'user_roles' && isMember();
    }
  }
}
